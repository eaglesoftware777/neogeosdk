; @f4 = FM bass motif
; @p0 = clean SSG preset

T132
V10
O4
L8

@p0
@b0
@f4

; phrase A
A C E A
G E C A
@a9
R8
F A C F
E C < B E

; phrase B
O4
A > C < A G
E G A C
@a3
R8
< B > C E G
A4 R4

; phrase C
O4
A G E C
D E G A
@a9
R8
C < A G E
A4 R4

; turnaround
@a6
R8
O4
A C E G
E D C A
G A C E
A4 R4

