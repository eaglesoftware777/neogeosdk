; samurai_game_loop.mml
; Layered gameplay loop with SSG lead, FM harmony, ADPCM-B bed, and ADPCM-A hits.

T124
V10
O4
L8

; Start the backing layers once at the top of the loop.
@p0
@b0
@f0

; Phrase A
A C D E G E D C
A C D E A > C < A G
@a4 R4
A C D E G E D C
D E G A > C < A G E

; Phrase B
@p1
A4 G8 E8 D4 E4
G A > C < A G E D
@a4 R4
A C D E G A > C < A
G E D C A4 R4

; Turnaround back into the loop
@p0
A C E A G E D C
@a4 R4
A C D E G E D C
~
