; @a2 = TITLE_GONG accent

T118
V12
O5
L8

@p0
@b0
@f0

; phrase A — rising arpeggio
C E G R
E G > C R
< A G E R
C4 R4

; phrase B — step-wise melody
O5
E F G A
G E C R
@a2
R
D F A R
G E C R

; phrase C — playful turnaround
O4
G > C E G
E C < G R
@a2
R
O4
G A B > C
C4 R4

; finish — descend and loop
O5
C E G E
C E G R
F A > C R
< G E C4

~
