[patch 6]
name=Vibrato Hero Lead
alg=7
fb=6
; stereo byte $C5 = L + R + AMS=0 + PMS=5 (±20 cents).  PMS=3 was
; too subtle to hear distinctly; PMS=7 was over-the-top siren.
; PMS=5 gives a clearly audible vibrato that still reads as
; "musical wobble" rather than detune.
stereo=C5
lfo=0A
op1=01,24,1F,0A,06,9F,00
op2=02,30,1F,0A,06,9F,00
op3=01,38,1F,0A,06,9F,00
op4=01,00,1F,08,05,8F,00

