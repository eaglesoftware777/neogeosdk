# These files are written by the art/sound build.  The Windows makefile
# emits them with CRLF and the Linux/WSL one with LF, so without this a
# rebuild on the other host shows every line of every one of them as
# changed - tens of thousands of lines of pure noise on top of whatever
# actually changed.  Normalising to LF in the repository makes a rebuild
# on either host a no-op unless the content really moved.
games/demo/artbox/assets.cfg            text eol=lf
games/demo/artbox/assets_manifest.json  text eol=lf
games/demo/artbox/infix_palettes.h      text eol=lf
games/demo/artbox/map                   text eol=lf
games/demo/artbox/out.srt               text eol=lf
games/demo/artbox/output1.txt           text eol=lf
games/demo/artbox/screens.c             text eol=lf
games/demo/artbox/sprite_meta.h         text eol=lf
games/demo/eyecatcher.c                 text eol=lf
games/demo/main.c                       text eol=lf

# Windows command scripts must be CRLF on disk: cmd.exe mis-reads a file
# whose lines end in a bare LF and drops the first characters of lines
# ("REM" runs as "M", "setlocal" as "tlocal"), which is how the art build
# ended up importing from games\artbox\in.  Store them as CRLF and check
# them out as CRLF on every host, whatever core.autocrlf says.
*.bat text eol=crlf
*.cmd text eol=crlf

# Written by tools/gen_trig.py: LF on every host, so a rebuild anywhere is
# byte-for-byte the committed file.
sdk/2d_engine/ng_trig_table.c   text eol=lf
